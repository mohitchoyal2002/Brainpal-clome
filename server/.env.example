# Server-only values. Never copy this key into the Android app or source code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local: file:brainpal.db. Vercel: a private Neon postgresql://... connection.
# Existing libsql://... databases are also supported.
DATABASE_URL=file:brainpal.db
DATABASE_AUTH_TOKEN=
# A private random string used only to hash registration IP quota keys.
RATE_LIMIT_SALT=replace-with-a-long-random-value
AI_DAILY_DEVICE_LIMIT=60
AI_DAILY_GLOBAL_LIMIT=500
PORT=8787
